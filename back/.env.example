PORT=4000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=networking_landing

# 'local' reads images from LOCAL_STORAGE_DIR; 'ftp' reads from the FTP_* server below
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=storage

FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false
FTP_BASE_DIR=/
